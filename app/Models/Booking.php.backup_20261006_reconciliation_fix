        FROM grooming_service_bookings
        JOIN quotations
            ON grooming_service_bookings.id = quotations.booking_id
        WHERE grooming_service_bookings.status = 'Completed'
          AND quotations.status = 'Accepted'
        GROUP BY booking_date


          UNION ALL

        SELECT
            'Training' AS service_name,
            DATE(training_service_bookings.created_at) AS booking_date,
            COUNT(training_service_bookings.id) AS total_bookings,
            SUM(quotations.bid_amount) AS total_price,
