    public function getMonthlyBookings()
    {
        $currentMonth = date('m');
        $currentYear = date('Y');

        // Get data from all three tables
        $walking = $this->getMonthlyBookingsForTable('walking_service_bookings', $currentMonth, $currentYear);
        $training = $this->getMonthlyBookingsForTable('training_service_bookings', $currentMonth, $currentYear);
        $grooming = $this->getMonthlyBookingsForTable('grooming_service_bookings', $currentMonth, $currentYear);

        // Combine results
        $combined = array_merge($walking, $training, $grooming);

        // Sum by category
        $summary = [];
        foreach ($combined as $item) {
            if (!isset($summary[$item->category])) {
                $summary[$item->category] = 0;
            }
            $summary[$item->category] += $item->total_bookings;
        }

        // Sort by total bookings
        arsort($summary);

        // Format results
        $results = [];
        foreach ($summary as $category => $total) {
            $results[] = (object) [
                'category' => $category,
                'total_bookings' => $total,
            ];
        }

        // Return top 5
        return array_slice($results, 0, 5);
    }

    protected function getMonthlyBookingsForTable($table, $month, $year)
    {
        return $this->db->table($table . ' as b')
            ->select('s.name as category, COUNT(b.id) as total_bookings')
            ->join('services as s', 's.id = b.service_id')
            ->where('MONTH(b.created_at)', $month)
            ->where('YEAR(b.created_at)', $year)
            ->groupBy('s.name')
            ->get()
            ->getResult();
    }
