    public function getDailyBookings()
    {
        $query = $this->db->query("
        SELECT
            'Walking' AS service_name,
            DATE(walking_service_bookings.created_at) AS booking_date,
            COUNT(walking_service_bookings.id) AS total_bookings,
            SUM(quotations.bid_amount) AS total_price,
