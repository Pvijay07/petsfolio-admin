    /**
     * OPTIMIZED: Server-side halted bookings with pagination, search, and deduplication
     * This replaces the old getHaltedWalkingBookings() method
     */
    public function getHaltedBookingsServerSide($start, $length, $search, $orderBy, $orderDir)
    {
        $today = date('Y-m-d');

        // Walking bookings with server-side processing
        $walkingBuilder = $this->db->table('walking_service_bookings wb');
        $walkingBuilder->select(
            'wb.id, wb.status, wb.service_start_date, wb.service_end_date, wb.created_at, wb.updated_at,
        wb.service_id, wb.address_id, wb.comment, wb.service_frequency, wb.walk_duration, 
        wb.service_days, wb.preferable_time,
        packages.package_name,
        users.name as user_name, users.phone as user_phone,
        COALESCE(user_pets.name, original_user_pets.name) as pet_name,
        COALESCE(user_pets.breed, original_user_pets.breed) as breed,
        user_addresses.city, user_addresses.state, user_addresses.address,
        user_addresses.latitude as booking_latitude, user_addresses.longitude as booking_longitude,
        user_addresses.houseno_floor, user_addresses.building_blockno, user_addresses.landmark_areaname,
        services.name as service_name,
        "walking" as service_type'
        );

        $walkingBuilder->join('packages', 'packages.id = wb.package_id', 'left')
            ->join('services', 'services.id = wb.service_id', 'left')
            ->join('users', 'users.id = wb.user_id', 'left')
            ->join('booking_pets', 'booking_pets.booking_id = wb.id', 'left')
            ->join('booking_pets as original_booking_pets', 'original_booking_pets.booking_id = wb.original_booking_id', 'left')
            ->join('user_pets', 'user_pets.id = booking_pets.pet_id', 'left')
            ->join('user_pets as original_user_pets', 'original_user_pets.id = original_booking_pets.pet_id', 'left')
            ->join('user_addresses', 'user_addresses.id = wb.address_id', 'left');

        $walkingBuilder->where('wb.service_start_date <', $today)
            ->where('wb.status', 'Halted')
            ->where('wb.is_deleted', false);

        // Grooming bookings
        $groomingBuilder = $this->db->table('grooming_service_bookings gb');
        $groomingBuilder->select(
            'gb.id, gb.status, gb.service_start_date,NULL as service_end_date, gb.created_at, gb.updated_at,
        gb.service_id, gb.address_id, gb.comment,
        NULL as service_frequency, NULL as walk_duration, NULL as service_days, NULL as preferable_time,
        NULL as package_name,
        users.name as user_name, users.phone as user_phone,
        user_pets.name as pet_name, user_pets.breed,
        user_addresses.city, user_addresses.state, user_addresses.address,
        user_addresses.latitude as booking_latitude, user_addresses.longitude as booking_longitude,
        user_addresses.houseno_floor, user_addresses.building_blockno, user_addresses.landmark_areaname,
        services.name as service_name,
        "grooming" as service_type'
        );

        $groomingBuilder->join('services', 'services.id = gb.service_id', 'left')
            ->join('users', 'users.id = gb.user_id', 'left')
            ->join('booking_pets', 'booking_pets.booking_id = gb.id', 'left')
            ->join('user_pets', 'user_pets.id = booking_pets.pet_id', 'left')
            ->join('user_addresses', 'user_addresses.id = gb.address_id', 'left');

        $groomingBuilder->where('gb.service_start_date <', $today)
            ->where('gb.status', 'Halted');

        // Training bookings
        $trainingBuilder = $this->db->table('training_service_bookings tb');
        $trainingBuilder->select(
            'tb.id, tb.status, tb.service_start_date, NULL as service_end_date, tb.created_at, tb.updated_at,
        tb.service_id, tb.address_id, tb.comment,
        NULL as service_frequency, NULL as walk_duration, NULL as service_days, NULL as preferable_time,
        packages.package_name,
        users.name as user_name, users.phone as user_phone,
        user_pets.name as pet_name, user_pets.breed,
        user_addresses.city, user_addresses.state, user_addresses.address,
        user_addresses.latitude as booking_latitude, user_addresses.longitude as booking_longitude,
        user_addresses.houseno_floor, user_addresses.building_blockno, user_addresses.landmark_areaname,
        services.name as service_name,
        "training" as service_type',
            false
        );

        $trainingBuilder->join('packages', 'packages.id = tb.package_id', 'left')
            ->join('users', 'users.id = tb.user_id', 'left')
            ->join('booking_pets', 'booking_pets.booking_id = tb.id', 'left')
            ->join('user_pets', 'user_pets.id = booking_pets.pet_id', 'left')
            ->join('user_addresses', 'user_addresses.id = tb.address_id', 'left')
            ->join('services', 'services.id = tb.service_id', 'left');

        $trainingBuilder->where('tb.status', 'Halted');

        // Combine all three queries using UNION
        $walkingSQL = $walkingBuilder->getCompiledSelect();
        $groomingSQL = $groomingBuilder->getCompiledSelect();
        $trainingSQL = $trainingBuilder->getCompiledSelect();

        $combinedSQL = "($walkingSQL) UNION ALL ($groomingSQL) UNION ALL ($trainingSQL)";

        // Get total before search
        $totalQuery = "SELECT COUNT(*) as total FROM ($combinedSQL) as combined_bookings";
        $totalResult = $this->db->query($totalQuery)->getRow();
        $total = $totalResult->total;

        // Apply search filter
        $searchSQL = '';
        if (!empty($search)) {
            $search = $this->db->escapeString($search);
            $searchSQL = " WHERE user_name LIKE '%{$search}%' 
                       OR user_phone LIKE '%{$search}%' 
                       OR service_name LIKE '%{$search}%'
                       OR pet_name LIKE '%{$search}%'";
        }

        // Get filtered count
        $filteredQuery = "SELECT COUNT(*) as total FROM ($combinedSQL) as combined_bookings {$searchSQL}";
        $filteredResult = $this->db->query($filteredQuery)->getRow();
        $filtered = $filteredResult->total;

        // Apply deduplication by grouping on user_phone, pet_name, service_name
        // Then apply ordering and pagination
        $finalQuery = "
        SELECT * FROM (
            SELECT *, 
                   ROW_NUMBER() OVER (
                       PARTITION BY user_phone, pet_name, service_name 
                       ORDER BY updated_at DESC
                   ) as row_num
            FROM ($combinedSQL) as combined_bookings
            {$searchSQL}
        ) as deduplicated
        WHERE row_num = 1
        ORDER BY {$orderBy} {$orderDir}
        LIMIT {$length} OFFSET {$start}
    ";

        $data = $this->db->query($finalQuery)->getResult();

        // Fetch packages for grooming bookings
        $groomingIds = [];
        foreach ($data as $booking) {
            if ($booking->service_type === 'grooming') {
                $groomingIds[] = $booking->id;
            }
        }

        $packages = [];
        if (!empty($groomingIds)) {
            $packageResults = $this->db->table('grooming_booking_packages')
                ->select('grooming_booking_packages.booking_id, packages.package_name, packages.price')
                ->join('packages', 'packages.id = grooming_booking_packages.package_id', 'left')
                ->whereIn('grooming_booking_packages.booking_id', $groomingIds)
                ->get()->getResult();

            foreach ($packageResults as $package) {
                $packages[$package->booking_id][] = $package;
            }
        }

        // Attach packages to bookings
        foreach ($data as $booking) {
            $booking->packages = $packages[$booking->id] ?? [];
            $booking->totalQuotes = 0; // Will be fetched on demand
        }

        return [
            'total' => $total,
            'filtered' => $filtered,
            'data' => $data
        ];
