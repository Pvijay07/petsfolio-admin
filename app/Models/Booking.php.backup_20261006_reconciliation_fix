    public function getCompletedBookingEarnings()
    {
        $query = $this->db->query("
        SELECT
            quotations.*,
            users.name as user_name,
            DATE_FORMAT(quotations.created_at, '%Y-%m') AS month,
            CASE
                WHEN walking_service_bookings.id IS NOT NULL THEN 'Walking'
                WHEN grooming_service_bookings.id IS NOT NULL THEN 'Grooming'
                WHEN training_service_bookings.id IS NOT NULL THEN 'Training'
            END as service_type,
            CASE
                WHEN walking_service_bookings.id IS NOT NULL THEN walking_service_bookings.status
                WHEN grooming_service_bookings.id IS NOT NULL THEN grooming_service_bookings.status
                WHEN training_service_bookings.id IS NOT NULL THEN training_service_bookings.status
            END as service_status
        FROM quotations
        LEFT JOIN walking_service_bookings ON walking_service_bookings.id = quotations.booking_id AND walking_service_bookings.status = 'Completed'
        LEFT JOIN grooming_service_bookings ON grooming_service_bookings.id = quotations.booking_id AND grooming_service_bookings.status = 'Completed'
        LEFT JOIN training_service_bookings ON training_service_bookings.id = quotations.booking_id AND training_service_bookings.status = 'Completed'
        LEFT JOIN users ON users.id = COALESCE(
            walking_service_bookings.user_id,
            grooming_service_bookings.user_id,
            training_service_bookings.user_id
        )
        WHERE quotations.status = 'Completed'
        AND (
            walking_service_bookings.id IS NOT NULL OR
            grooming_service_bookings.id IS NOT NULL OR
            training_service_bookings.id IS NOT NULL
        )
        ORDER BY quotations.created_at DESC
    ");

        return $query->getResult();
    }

