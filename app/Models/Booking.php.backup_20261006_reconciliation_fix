                service_providers.id as provider_id,
                service_providers.name as provider_name,
                service_providers.phone as provider_phone,
                quotations.bid_amount,
                quotations.id as quotation_id,
                'walking' as service_type,
                (SELECT COUNT(*) FROM quotations q WHERE q.booking_id = wb.id AND q.provider_id != COALESCE(quotations.provider_id, 0) AND q.status = 'Pending') as totalQuotes
            ")
            ->join('users', 'users.id = wb.user_id', 'left')
            ->join('booking_pets', 'booking_pets.booking_id = wb.id', 'left')
            ->join('booking_pets as original_booking_pets', 'original_booking_pets.booking_id = wb.original_booking_id', 'left')
            ->join('user_pets', 'user_pets.id = booking_pets.pet_id', 'left')
            ->join('user_pets as original_user_pets', 'original_user_pets.id = original_booking_pets.pet_id', 'left')
            ->join('quotations', 'quotations.booking_id = wb.id', 'left')
            ->join('service_providers', 'service_providers.id = quotations.provider_id', 'left');

        $this->applyStatusConditions($walkingQuery, $config, 'wb');

        // For halted bookings, add date condition
        if ($config['status'] === 'Halted') {
            $walkingQuery->where('wb.service_start_date <', $today);
        }

        // Grooming bookings subquery
        $groomingQuery = $this->db->table('grooming_service_bookings gb')
