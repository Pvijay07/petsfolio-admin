    public function getCancelledBookingsCount($status)
    {
        $walkingCount = $this->db->table('walking_service_bookings')
            ->join('quotations', 'quotations.booking_id = walking_service_bookings.id', 'left')
            ->where('walking_service_bookings.status', $status)
            ->where('quotations.status', 'Cancelled')
            ->where('walking_service_bookings.is_deleted', false)
            ->countAllResults();

        $groomingCount = $this->db->table('grooming_service_bookings')
            ->join('quotations', 'quotations.booking_id = grooming_service_bookings.id', 'left')
            ->where('grooming_service_bookings.status', $status)
            ->where('quotations.status', 'Cancelled')
            ->countAllResults();

        $trainingCount = $this->db->table('training_service_bookings')
            ->where('training_service_bookings.status', $status)
            ->countAllResults();

        return [
            'total' => $walkingCount + $groomingCount + $trainingCount,
            'walking' => $walkingCount,
            'grooming' => $groomingCount,
            'training' => $trainingCount
        ];
