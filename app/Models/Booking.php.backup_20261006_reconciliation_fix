    public function getServiceWalletSummary()
    {
        $services = ['walking', 'grooming', 'training'];
        $queries = [];

        foreach ($services as $service) {
            $table = $service . '_service_bookings';

            $swh_subquery = $this->db->table('sp_wallet_histories')
                ->select('booking_id, SUM(amount) as total_approved')
                ->where('category', 'approved_amount')
                ->groupBy('booking_id');

            $uwh_subquery = $this->db->table('user_wallet_histories')
                ->select('booking_id, SUM(amount) as total_refunds')
                ->where('category', 'refund_amount')
                ->groupBy('booking_id');

            $queries[] = $this->db->table("$table as b")

                ->select("
                '$service' as service_type,
                b.id as booking_id,
                b.created_at as created_at,
                u.name as client_name,
                sp.name as walker_name,
                q.bid_amount as booking_amt,
                COALESCE(uwh.total_refunds, 0) as refunds,
                COALESCE(swh.total_approved, 0) as walker_payouts,
                (COALESCE(swh.total_approved, 0) * 0.1111) as pf_earnings,
                (q.bid_amount - COALESCE(uwh.total_refunds, 0)) as net_booking_amt,
               CASE 
    WHEN b.status IN ('Confirmed', 'In Progress') THEN 'Pending'

    WHEN COALESCE(swh.total_approved, 0) = 0 
         AND COALESCE(uwh.total_refunds, 0) = 0 
    THEN 'Pending'

    WHEN ROUND(COALESCE(swh.total_approved, 0), 2) = 
         ROUND((q.bid_amount - COALESCE(uwh.total_refunds, 0)) * 0.90, 2)
    THEN 'Balanced'

    ELSE 'Mismatch'
END AS status

            ")

                ->join('users as u', 'u.id = b.user_id')
                ->join('quotations as q', 'q.booking_id = b.id', 'left')
                ->join('service_providers as sp', 'sp.id = q.provider_id', 'left')
                ->join('(' . $uwh_subquery->getCompiledSelect() . ') as uwh', 'uwh.booking_id = b.id', 'left')
                ->join('(' . $swh_subquery->getCompiledSelect() . ') as swh', 'swh.booking_id = b.id', 'left')
                ->whereIn('b.status', ['Confirmed', 'Completed'])
                ->getCompiledSelect();
        }

        $unionQuery = implode(' UNION ALL ', $queries);
        $results = $this->db->query($unionQuery)->getResultArray();

        foreach ($results as &$row) {
            $rawCreatedAt = $row['created_at'] ?? null;
            if (!empty($rawCreatedAt)) {
                try {
                    $dt = new \DateTime($rawCreatedAt, new \DateTimeZone('UTC'));
                    $dt->setTimezone(new \DateTimeZone('Asia/Kolkata'));
                    $row['date'] = $dt->format('Y-m-d');
                    $row['created_at'] = $dt->format('Y-m-d H:i:s');
                    $row['created_at_utc'] = $rawCreatedAt;
                } catch (\Throwable $e) {
                    $row['date'] = date('Y-m-d', strtotime($rawCreatedAt));
                }
            } else {
                $row['date'] = date('Y-m-d');
            }
        }

        return $results;
    }



    public function getWalletSummary($walletType, $userId = null)
    {
        $db = \Config\Database::connect();
        $builder = null;

        if ($walletType === 'client') {
            $builder = $db->table('user_wallet_histories uw');
            $builder->select("
            uw.id as txn_id,
            uw.service_id,
            uw.booking_id,
            uw.transaction_type,
            uw.category,
            uw.amount,
            uw.balance_after,
            uw.refund_balance,
            uw.description,
            uw.created_at,
            u.id as client_id,
            u.phone as client_phone,
            u.name as client_name
            ");
            $builder->join('users u', 'u.id = uw.user_id', 'left');

            if ($userId) {
                $builder->where('uw.user_id', $userId);
            }
        } elseif ($walletType === 'walker') {
            $builder = $db->table('sp_wallet_histories sw');
            $builder->select("
            sw.id as txn_id,
            sw.service_id,
            sw.booking_id,
            sw.transaction_type,
            sw.category,
            sw.amount,
            sw.description,
            sw.created_at,
            sp.id as walker_id,
            sp.phone as walker_phone,
            sp.name as walker_name
            ");
            $builder->join('service_providers sp', 'sp.id = sw.provider_id', 'left');

            if ($userId) {
                $builder->where('sw.provider_id', $userId);
            }
        } else {
            $builder = $db->table('platform_wallet_histories');
            $builder->select("
            id as txn_id,
            service_type as service_id,
            booking_id,
            transaction_type,
            commission_amount as amount,
            description,
            created_at
            ");
        }

        if (!$builder) {
            return [];
        }

        $builder->orderBy('created_at', 'ASC');
        $result = $builder->get()->getResultArray();

        $summary = [];
        $balances = [];
        $earnedBalance = [];
        $refundBalanceByBooking = [];
        $firstCreditByBooking = [];

        foreach ($result as $row) {
            $amount = isset($row['amount']) ? $row['amount'] : 0;
            $bookingId = $row['booking_id'];

            if ($walletType === 'walker') {
                $currentUser = $row['walker_id'];
            } elseif ($walletType === 'client') {
                $currentUser = $row['client_id'];
            } else {
                $currentUser = 'platform';
            }

            if (!isset($balances[$currentUser])) {
                $balances[$currentUser] = 0;
            }
            if (!isset($earnedBalance[$currentUser])) {
                $earnedBalance[$currentUser] = 0;
            }
            if (!isset($firstCreditByBooking[$currentUser][$bookingId])) {
                $firstCreditByBooking[$currentUser][$bookingId] = false;
            }
            if (!isset($refundBalanceByBooking[$currentUser][$bookingId])) {
                $refundBalanceByBooking[$currentUser][$bookingId] = 0;
            }

            // Apply transaction logic
            if ($walletType === 'walker') {
                if ($row['transaction_type'] === 'credit') {
                    if ($row['category'] === 'booking_amount') {
                        $balances[$currentUser] += $amount;
                    } else {
                        $balances[$currentUser] -= $amount;
                    }
                } elseif ($row['transaction_type'] === 'debit') {
                    $balances[$currentUser] -= $amount;
                }
            } elseif ($walletType === 'client') {
                if ($row['transaction_type'] === 'credit') {
                    if (!$firstCreditByBooking[$currentUser][$bookingId]) {
                        $balances[$currentUser] += $amount;
                        $firstCreditByBooking[$currentUser][$bookingId] = true;
                    } else {
                        $balances[$currentUser] -= $amount;
                    }
                } else {
                    $balances[$currentUser] -= $amount;
                }

                $refundBalanceByBooking[$currentUser][$bookingId] = $row['refund_balance'] ?? 0;
                if ($row['category'] === 'refund_amount_used') {
                    $balances[$currentUser] = 0;
                }
            } else {
                $balances[$currentUser] += $amount;
            }

            // Ensure no negatives
            $balances[$currentUser] = max(0, $balances[$currentUser]);

            // Earned balance
            if ($row['transaction_type'] === 'credit' && isset($row['category']) && $row['category'] === 'approved_amount') {
                $earnedBalance[$currentUser] += $amount;
            }

            // Append to summary
            $rawCreatedAt = $row['created_at'] ?? null;
            $istCreatedAt = $rawCreatedAt;
            $istDate = !empty($rawCreatedAt) ? date('Y-m-d', strtotime($rawCreatedAt)) : null;

            if (!empty($rawCreatedAt)) {
                try {
                    $dt = new \DateTime($rawCreatedAt, new \DateTimeZone('UTC'));
                    $dt->setTimezone(new \DateTimeZone('Asia/Kolkata'));
                    $istCreatedAt = $dt->format('Y-m-d H:i:s');
                    $istDate = $dt->format('Y-m-d');
                } catch (\Throwable $e) {
                }
            }

            $summary[] = [
                'txn_id' => 'TXN-' . str_pad($row['txn_id'], 3, '0', STR_PAD_LEFT),
                'service_id' => $row['booking_id'],
                'created_at' => $istCreatedAt,
                'created_at_utc' => $rawCreatedAt,
                'date' => $istDate,
                'action' => $row['description'],
                'debit' => ($row['transaction_type'] === 'debit') ? number_format($amount, 2) : '0.00',
                'credit' => ($row['transaction_type'] === 'credit') ? number_format($amount, 2) : '0.00',
                'balance' => number_format($balances[$currentUser], 2),
                'refundBalance' => number_format($refundBalanceByBooking[$currentUser][$bookingId], 2),
                'earned_balance' => number_format($earnedBalance[$currentUser], 2),

                'client_id' => $row['client_id'] ?? null,
                'client_phone' => $row['client_phone'] ?? null,
                'client_name' => $row['client_name'] ?? null,
                'walker_name' => $row['walker_name'] ?? null,
                'walker_id' => $row['walker_id'] ?? null,
                'walker_phone' => $row['walker_phone'] ?? null,
            ];
        }


        return $summary;
    }

