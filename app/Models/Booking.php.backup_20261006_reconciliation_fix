    public function getBookingsServerSide($status, $start = 0, $length = 25, $search = '', $orderBy = 'created_at', $orderDir = 'desc')
    {
        // Get data from all services
        $walkingData = $this->getWalkingBookingsServerSide($status, $start, $length, $search, $orderBy, $orderDir);
        $groomingData = $this->getGroomingBookingsServerSide($status, $start, $length, $search, $orderBy, $orderDir);
        $trainingData = $this->getTrainingBookingsServerSide($status, $start, $length, $search, $orderBy, $orderDir);

        // Combine all data
        $allData = array_merge($walkingData['data'], $groomingData['data'], $trainingData['data']);

        // Apply sorting to combined data
        usort($allData, function ($a, $b) use ($orderBy, $orderDir) {
            $aValue = $a->{$orderBy} ?? '';
            $bValue = $b->{$orderBy} ?? '';

            if ($orderDir === 'desc') {
                return $bValue <=> $aValue;
            }
            return $aValue <=> $bValue;
        });

        // Apply pagination to sorted data
        $paginatedData = array_slice($allData, $start, $length);

        $this->attachPets($paginatedData);

        return [
            'total' => $walkingData['total'] + $groomingData['total'] + $trainingData['total'],
            'filtered' => $walkingData['filtered'] + $groomingData['filtered'] + $trainingData['filtered'],
            'data' => $paginatedData
        ];
    }

    private function getWalkingBookingsServerSide($status, $start, $length, $search, $orderBy, $orderDir)
    {
        $builder = $this->db->table('walking_service_bookings wb');

        $builder->select(
            'wb.*, 
            packages.package_name as package_name,
            users.name as user_name, 
            users.phone as user_phone,
            COALESCE(user_pets.name, original_user_pets.name) as pet_name,
            COALESCE(user_pets.type, original_user_pets.type) as type,
            COALESCE(user_pets.breed, original_user_pets.breed) as breed,
            user_addresses.city, 
            user_addresses.state, 
            user_addresses.address, 
            user_addresses.latitude as booking_latitude, 
            user_addresses.longitude as booking_longitude,
            user_addresses.houseno_floor,
            user_addresses.building_blockno,
            user_addresses.landmark_areaname,
            service_providers.id as provider_id,
            service_providers.name as provider_name,
            service_providers.phone as provider_phone,
            services.name as service_name,
            quotations.id as quotation_id,
            quotations.bid_amount,
            user_withdrawal_wallet.amount as user_withdrawal_amount,
            "walking" as service_type'
        );

        $builder->join('packages', 'packages.id = wb.package_id', 'left');
        $builder->join('services', 'services.id = wb.service_id', 'left');
        $builder->join('users', 'users.id = wb.user_id', 'left');
        $builder->join('booking_pets', 'booking_pets.booking_id = wb.id', 'left');
        $builder->join('booking_pets as original_booking_pets', 'original_booking_pets.booking_id = wb.original_booking_id', 'left');
        $builder->join('user_pets', 'user_pets.id = booking_pets.pet_id', 'left');
        $builder->join('user_pets as original_user_pets', 'original_user_pets.id = original_booking_pets.pet_id', 'left');
        $builder->join('user_addresses', 'user_addresses.id = wb.address_id', 'left');
        $builder->join('quotations', 'quotations.booking_id = wb.id AND quotations.status = "Accepted"', 'left');
        $builder->join('service_providers', 'service_providers.id = quotations.provider_id', 'left');
        $builder->join('user_withdrawal_wallet', 'user_withdrawal_wallet.user_id = users.id', 'left');

        $builder->where('wb.status', $status);
        if ($status === 'New') {
            $builder->where('wb.type !=', 'premium');
        }

        // Get total count
        $totalBuilder = clone $builder;
        $total = $totalBuilder->countAllResults();

