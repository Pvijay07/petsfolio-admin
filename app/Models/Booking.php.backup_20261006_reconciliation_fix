            SUM(quotations.gst) AS gst
        FROM walking_service_bookings
        JOIN quotations
            ON walking_service_bookings.id = quotations.booking_id
        WHERE walking_service_bookings.status = 'Completed'
          AND quotations.status = 'Accepted'
        GROUP BY booking_date

        UNION ALL

        SELECT
            'Grooming' AS service_name,
            DATE(grooming_service_bookings.created_at) AS booking_date,
            COUNT(grooming_service_bookings.id) AS total_bookings,
