        $builder->groupBy('a.state, a.city');

        $results = $builder->get()->getResultArray();

        // Organize data by state > city
        return $this->organizeStats($results);
    }
    private function organizeStats($results)
    {
        $organized = [];
        foreach ($results as $row) {
            $state = $row['state'];
            $city = $row['city'];

            if (!isset($organized[$state])) {
                $organized[$state] = [
                    'name' => $state,
                    'clients_signed_up' => 0,
                    'jobs_posted' => 0,
                    'unassigned_jobs' => 0,
                    'assigned' => 0,
                    'sp_replaced' => 0,
                    'cancelled' => 0,
                    'refunds' => 0,
                    'completed' => 0,
                    'renewals' => 0,
                    'cities' => []
                ];
            }

            // Update state totals
            foreach ($row as $key => $value) {
                if ($key !== 'state' && $key !== 'city') {
                    $organized[$state][$key] += $value;
                }
            }

            // Add city data
            $organized[$state]['cities'][$city] = $row;
            $organized[$state]['cities'][$city]['name'] = $city;
        }

        return $organized;
    }

