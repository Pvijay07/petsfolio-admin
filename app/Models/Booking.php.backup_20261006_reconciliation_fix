    public function getMostRequests()
    {
        // Grooming bookings grouped by area
        $grooming = $this->db->table('grooming_service_bookings')
            ->select('user_addresses.city')
            ->select('COUNT(grooming_service_bookings.id) as total_bookings')
            ->select('COUNT(DISTINCT grooming_service_bookings.user_id) as total_clients')
            ->join('users', 'users.id = grooming_service_bookings.user_id', 'left')
            ->join('user_addresses', 'user_addresses.user_id = users.id', 'left')
            ->whereIn('grooming_service_bookings.status', ['New', 'Confirmed', 'Completed', 'Cancelled'])
            ->having('total_bookings >', 10)

            ->groupBy('user_addresses.city')
            ->get()
            ->getResult();

        // Walking bookings grouped by city
        $walking = $this->db->table('walking_service_bookings')
            ->select('user_addresses.city')
            ->select('COUNT(walking_service_bookings.id) as total_bookings')
            ->select('COUNT(DISTINCT walking_service_bookings.user_id) as total_clients')
            ->join('users', 'users.id = walking_service_bookings.user_id', 'left')
            ->join('user_addresses', 'user_addresses.user_id = users.id', 'left')
            ->whereIn('walking_service_bookings.status', ['New', 'Confirmed', 'Completed', 'Cancelled'])
            ->having('total_bookings >', 10)

            ->groupBy('user_addresses.city')
            ->get()
            ->getResult();

        $training = $this->db->table('training_service_bookings')
            ->select('user_addresses.city')
            ->select('COUNT(training_service_bookings.id) as total_bookings')
            ->select('COUNT(DISTINCT training_service_bookings.user_id) as total_clients')
            ->join('users', 'users.id = training_service_bookings.user_id', 'left')
            ->join('user_addresses', 'user_addresses.user_id = users.id', 'left')
            ->whereIn('training_service_bookings.status', ['New', 'Confirmed', 'Completed', 'Cancelled'])
            ->having('total_bookings >', 10)

            ->groupBy('user_addresses.city')
            ->get()
            ->getResult();

        // Merge both bookings
        $merged = [];

        // Convert to associative by city
        foreach ($grooming as $row) {
            $merged[$row->city] = [
                'city' => $row->city,
                'total_bookings' => $row->total_bookings,
                'total_clients' => $row->total_clients,
            ];
        }
        foreach ($training as $row) {
            $merged[$row->city] = [
                'city' => $row->city,
                'total_bookings' => $row->total_bookings,
                'total_clients' => $row->total_clients,
            ];
        }
        foreach ($walking as $row) {
            if (isset($merged[$row->city])) {
                $merged[$row->city]['total_bookings'] += $row->total_bookings;
                $merged[$row->city]['total_clients'] += $row->total_clients;
            } else {
                $merged[$row->city] = [
                    'city' => $row->city,
                    'total_bookings' => $row->total_bookings,
                    'total_clients' => $row->total_clients,
                ];
            }
        }

        // Now get total service providers for each city
        foreach ($merged as $city => &$data) {
            $providers = $this->db->table('service_providers')
                ->where('city', $city)
                ->countAllResults();

            $data['total_providers'] = $providers;
        }

        return array_values($merged); // return indexed array
    }
