            $walkingSQL = str_replace('WHERE', "WHERE {$searchCondition} AND", $walkingSQL);
            $groomingSQL = str_replace('WHERE', "WHERE {$searchCondition} AND", $groomingSQL);
            $trainingSQL = str_replace('WHERE', "WHERE {$searchCondition} AND", $trainingSQL);
        }

        return "({$walkingSQL}) UNION ALL ({$groomingSQL}) UNION ALL ({$trainingSQL})";
    }

    private function buildCountUnionQuery($config, $search)
    {
        $today = date('Y-m-d');

        // Walking bookings count
        $walkingQuery = $this->db->table('walking_service_bookings wb')
            ->select("COUNT(*) as count")
            ->join('users', 'users.id = wb.user_id', 'left')
            ->join('quotations', 'quotations.booking_id = wb.id', 'left')
            ->join('service_providers', 'service_providers.id = quotations.provider_id', 'left');

        $this->applyStatusConditions($walkingQuery, $config, 'wb');

        if ($config['status'] === 'Halted') {
            $walkingQuery->where('wb.service_start_date <', $today);
        }

        // Grooming bookings count
        $groomingQuery = $this->db->table('grooming_service_bookings gb')
            ->select("COUNT(*) as count")
            ->join('users', 'users.id = gb.user_id', 'left')
            ->join('quotations', 'quotations.booking_id = gb.id', 'left')
            ->join('service_providers', 'service_providers.id = quotations.provider_id', 'left');

        $this->applyStatusConditions($groomingQuery, $config, 'gb');

        // Training bookings count
        $trainingQuery = $this->db->table('training_service_bookings tb')
            ->select("COUNT(*) as count")
            ->join('users', 'users.id = tb.user_id', 'left')
            ->join('quotations', 'quotations.booking_id = tb.id', 'left')
            ->join('service_providers', 'service_providers.id = quotations.provider_id', 'left');

        $this->applyStatusConditions($trainingQuery, $config, 'tb');

        // Apply search if provided
        if (!empty($search)) {
            $searchCondition = $this->buildSearchCondition($search);
            $walkingQuery->groupStart()
                ->like('users.name', $search)
                ->orLike('users.phone', $search)
                ->orLike('service_providers.name', $search)
                ->groupEnd();

            $groomingQuery->groupStart()
                ->like('users.name', $search)
                ->orLike('users.phone', $search)
                ->orLike('service_providers.name', $search)
                ->groupEnd();

            $trainingQuery->groupStart()
                ->like('users.name', $search)
                ->orLike('users.phone', $search)
                ->orLike('service_providers.name', $search)
                ->groupEnd();
        }

        $walkingSQL = $walkingQuery->getCompiledSelect(false);
        $groomingSQL = $groomingQuery->getCompiledSelect(false);
        $trainingSQL = $trainingQuery->getCompiledSelect(false);

        return "SELECT SUM(count) as total_count FROM (
            ({$walkingSQL}) UNION ALL 
            ({$groomingSQL}) UNION ALL 
            ({$trainingSQL})
        ) as counts";
    }

    private function applyStatusConditions(&$query, $config, $alias)
    {
        // Apply status condition
        if ($config['status'] !== null) {
            $query->where("{$alias}.status", $config['status']);
        }

        // Apply deleted condition
        if ($config['deleted'] !== null) {
            $query->where("{$alias}.is_deleted", $config['deleted']);
        }

        // Apply quotation status condition
        if ($config['quote_status'] !== null) {
            if (is_array($config['quote_status'])) {
                $query->whereIn('quotations.status', $config['quote_status']);
            } else {
                $query->where('quotations.status', $config['quote_status']);
            }
        }
    }

    private function buildSearchCondition($search)
    {
        $escapedSearch = $this->db->escapeLikeString($search);

        return "(
            users.name LIKE '%{$escapedSearch}%' OR
            users.phone LIKE '%{$escapedSearch}%' OR
            service_providers.name LIKE '%{$escapedSearch}%'
        )";
    }

    private function mapOrderColumn($column)
