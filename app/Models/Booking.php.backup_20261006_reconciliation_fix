    public function getProvidersCount()
    {
        $total = $this->db->table('service_providers')->countAll();

        $reported = $this->db->table('sp_bookings')
            ->where('report_reason !=', null)
            ->countAllResults();

        $absents = $this->db->table('walking_tracking')
            ->where('status', 'Untracked')
            ->countAllResults();

        $lates = $this->db->table('walking_tracking')
            ->where('service_time <', 'start_time')
            ->countAllResults();

        $pending_verification = $this->db->table('service_providers')
            ->join('sp_verifications', 'sp_verifications.provider_id = service_providers.id', 'left')
            ->join('sp_walking_details', 'sp_walking_details.provider_id = service_providers.id', 'left')
            ->join('sp_grooming_details', 'sp_grooming_details.provider_id = service_providers.id', 'left')
            ->join('sp_training_details', 'sp_training_details.provider_id = service_providers.id', 'left')
            ->join('sp_boarding_details', 'sp_boarding_details.provider_id = service_providers.id', 'left')
            ->groupStart()
            ->groupStart()
            ->where('sp_walking_details.certificate !=', null)
            ->where('sp_verifications.walking_verified', 0)
            ->groupEnd()
            ->orGroupStart()
            ->where('sp_grooming_details.certificate !=', null)
            ->where('sp_verifications.grooming_verified', 0)
            ->groupEnd()
            ->orGroupStart()
            ->where('sp_training_details.certificate !=', null)
            ->where('sp_verifications.training_verified', 0)
            ->groupEnd()
            ->orGroupStart()
            ->where('sp_boarding_details.certificate !=', null)
            ->where('sp_verifications.boarding_verified', 0)
            ->groupEnd()
            ->groupEnd()
            ->countAllResults();

        $client_refund_requests = $this->db->table('user_refunds')
            ->whereIn('status', ['requested', 'pending'])
            ->where('amount >', 0)
            ->countAllResults();

        $client_supports = $this->db->table('tickets')->where(['status!=' => 'resolved', 'user_type' => 'client'])->countAllResults();
        $sp_supports = $this->db->table('tickets')->where(['status!=' => 'resolved', 'user_type' => 'service_provider'])->countAllResults();
        return (object) [
            'total' => $total,
            'reported' => $reported,
            'absents' => $absents,
            'lates' => $lates,
            'pending_verification' => $pending_verification,
            'client_refund_requests' => $client_refund_requests,
            'client_supports' => $client_supports,
            'sp_supports' => $sp_supports,
        ];
    }
